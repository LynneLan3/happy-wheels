---
import generated from '../../v4/generated/example-site.json';
import '../../v4/visual-system.css';
import '../../v4/product-overrides.css';
import V4GlobalHeader from '../../components/v4/V4GlobalHeader.astro';
const groups = generated.navigation.primary.flatMap((category) => category.groups ?? []).map((group) => ({ label: group.label, ids: group.items.map((item) => item.pageId).filter(Boolean).map((id) => generated.pages.find((page) => page.id === id)).filter((page): page is (typeof generated.pages)[number] => Boolean(page)) })).filter((group) => group.ids.length > 0).map((group) => ({ ...group, priority: Math.max(...group.ids.map((item) => item.pageData.intent.priority)) }));
groups.sort((a, b) => b.priority - a.priority);
const identity = (generated.game as any).identity ?? {};
const identityStyle = `--v4-identity-background:${identity.background ? `url(${identity.background})` : 'none'};--v4-identity-texture:${identity.texture ? `url(${identity.texture})` : 'none'};--v4-display-font:${identity.typography === 'serif' ? 'Georgia,serif' : 'Inter,ui-sans-serif,sans-serif'};--v4-bg:${identity.palette?.background ?? '#101416'};--v4-panel:${identity.palette?.panel ?? '#19211f'};--v4-ink:${identity.palette?.ink ?? '#eef3ef'};`;
---
<html lang="en"><head><title>Categories - {generated.game.name}</title></head><body class="v4-shell" style={identityStyle}><main class="v4-home">
  <V4GlobalHeader game={generated.game} navigation={generated.navigation} currentPageId="category" />
  <header class="v4-answer-header"><p class="v4-kicker">Browse the guide</p><h1>What are you trying to do?</h1><p class="v4-muted">Choose a guide area, then open the answer that matches your goal.</p></header>
  <section class="v4-category-list">{groups.map((group) => { const featured = group.ids[0]; const browse = group.ids.slice(1); const updated = browse.filter((item) => Boolean(item.pageData.freshness?.dataWindow || item.pageData.freshness?.version)); const popular = browse.filter((item) => item.pageData.intent.priority >= group.priority); return <section class="v4-category-surface"><div class="v4-section-heading"><div><span class="v4-kicker">Scope · {group.ids.length} research-backed answers</span><h2>{group.label}</h2><p class="v4-muted">Start with the primary task, then browse supporting answers.</p></div><span>Priority {group.priority}</span></div>{featured && <a class="v4-category-feature" href={featured.href}><span><b class="v4-kicker">Featured / primary task</b><strong>{featured.title}</strong><small>{featured.pageData.intent.playerProblem}</small></span><b>Open</b></a>}<div class="v4-discovery-list">{browse.map((item) => <a class="v4-discovery-item" href={item.href}>{item.pageData.media?.[0]?.localRef && <img src={item.pageData.media[0].localRef} alt="" loading="lazy" />}<span><strong>{item.title}</strong><small>{item.pageData.intent.playerProblem}</small></span><b>Open</b></a>)}</div>{popular.length > 0 && <div class="v4-category-subsection"><span class="v4-kicker">Popular</span>{popular.map((item) => <a href={item.href}>{item.title}</a>)}</div>}{updated.length > 0 && <div class="v4-category-subsection"><span class="v4-kicker">Recently updated</span>{updated.map((item) => <a href={item.href}>{item.title}</a>)}</div>}</section>})}</section>
</main></body></html>
