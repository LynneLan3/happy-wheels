---
import generated from '../../v4/generated/example-site.json';
import '../../v4/visual-system.css';
import '../../v4/product-overrides.css';
import V4GlobalHeader from '../../components/v4/V4GlobalHeader.astro';
import { PLAYER_TASK_LABELS, type PlayerTask } from '../../v4/intent-contract';
const searchable = (generated.pages as any[]).map((page) => ({ id: page.id, title: page.title, href: page.href, type: PLAYER_TASK_LABELS[page.pageData.intent.primaryTask as PlayerTask], query: page.pageData.intent.query, problem: page.pageData.intent.playerProblem, priority: page.pageData.intent.priority, text: [page.pageData.body?.intro, ...page.pageData.body?.sections?.flatMap((section: any) => [...section.paragraphs, ...section.bullets]) ?? [], ...page.pageData.body?.faq?.flatMap((item: any) => [item.question, item.answer]) ?? [], ...page.pageData.facts.map((fact: any) => `${fact.label} ${fact.value}`)].filter(Boolean).join(' ') }));
const identity = (generated.game as any).identity ?? {};
const identityStyle = `--v4-identity-background:${identity.background ? `url(${identity.background})` : 'none'};--v4-identity-texture:${identity.texture ? `url(${identity.texture})` : 'none'};--v4-display-font:${identity.typography === 'serif' ? 'Georgia,serif' : 'Inter,ui-sans-serif,sans-serif'};--v4-bg:${identity.palette?.background ?? '#101416'};--v4-panel:${identity.palette?.panel ?? '#19211f'};--v4-ink:${identity.palette?.ink ?? '#eef3ef'};`;
---
<html lang="en"><head><title>Search - {generated.game.name}</title></head><body class="v4-shell" style={identityStyle}><main class="v4-home" data-v4-search-page>
  <V4GlobalHeader game={generated.game} navigation={generated.navigation} currentPageId="search" />
  <header class="v4-answer-header"><p class="v4-kicker">Guide search</p><h1>Search {generated.game.name}</h1><p class="v4-muted">Find answers from the current guide.</p></header>
  <form class="v4-search-form" role="search"><label for="v4-search-input">Search the guide<input id="v4-search-input" name="q" type="search" placeholder="Try: controls, upgrades, release" autocomplete="off" autofocus /></label><button class="v4-action" type="submit">Search</button></form>
  <p class="v4-search-status" aria-live="polite" data-v4-search-status>{searchable.length} indexed answers</p>
  <p class="v4-search-empty" data-v4-search-empty hidden>No matching answers. Try a broader task, item, or mechanic.</p><section class="v4-search-results" aria-label="Search results" data-v4-search-results>{searchable.map((item) => <a class="v4-search-result" href={item.href} data-search-text={`${item.title} ${item.type} ${item.query} ${item.problem} ${item.text}`} data-search-priority={item.priority}><span class="v4-search-type">{item.type}</span><strong>{item.title}</strong><small>{item.problem}</small><em>{item.text.slice(0, 150)}</em></a>)}</section>
</main></body><script is:inline>
const form=document.querySelector('.v4-search-form'), input=document.querySelector('#v4-search-input'), status=document.querySelector('[data-v4-search-status]'), items=[...document.querySelectorAll('.v4-search-result')];
const empty=document.querySelector('[data-v4-search-empty]');const run=()=>{const q=input.value.trim().toLowerCase();const tokens=q.split(/\s+/).filter(Boolean);let count=0;items.forEach(item=>{const text=item.dataset.searchText.toLowerCase();const title=item.querySelector('strong')?.textContent?.toLowerCase()||'';const exact=title===q?100:title.includes(q)?50:0;const matches=tokens.filter(token=>text.includes(token)).length;item.dataset.searchScore=String(exact+matches*10);const show=!q||matches>0;item.hidden=!show;if(show)count+=1});items.sort((a,b)=>Number(b.dataset.searchScore)-Number(a.dataset.searchScore)||Number(b.dataset.searchPriority)-Number(a.dataset.searchPriority)||a.textContent.localeCompare(b.textContent)).forEach(item=>document.querySelector('[data-v4-search-results]')?.append(item));if(empty)empty.hidden=count>0;status.textContent=count+' result'+(count===1?'':'s')+(q?' for '+q:'')};form.addEventListener('submit',e=>{e.preventDefault();run()});input.addEventListener('input',run);document.addEventListener('keydown',e=>{if(e.key==='/'&&document.activeElement!==input){e.preventDefault();input.focus()}});run();
</script></html>
