---
import generated from '../v4/generated/example-site.json';
import V4GlobalHeader from '../components/v4/V4GlobalHeader.astro';
import '../v4/visual-system.css';
import '../v4/product-overrides.css';

const taskLabel = (page: any) => page?.pageData.intent.primaryTask.replaceAll('-', ' ');
const surfaces = (generated.homepage as any).surfaces ?? [];
const bySurface = (surface: any) => (surface.pageIds ?? []).map((id: string) => generated.pages.find((page) => page.id === id)).filter(Boolean);
const identity = (generated.game as any).identity ?? {};
const identityStyle = `--v4-identity-background:${identity.background ? `url(${identity.background})` : 'none'};--v4-identity-texture:${identity.texture ? `url(${identity.texture})` : 'none'};--v4-display-font:${identity.typography === 'serif' ? 'Georgia,serif' : 'Inter,ui-sans-serif,sans-serif'};--v4-bg:${identity.palette?.background ?? '#101416'};--v4-panel:${identity.palette?.panel ?? '#19211f'};--v4-ink:${identity.palette?.ink ?? '#eef3ef'};`;
---
<html lang="en"><head><title>{generated.game.name} · Utility Wiki</title></head><body class="v4-shell" style={identityStyle}><main class="v4-home">
  <V4GlobalHeader game={generated.game} navigation={generated.navigation} currentPageId="home" />
  <header class="v4-site-identity"><div><p class="v4-kicker">Current guide</p><h1>{generated.game.name}</h1><p>Choose a focused answer from the current research set.</p></div></header>
  <section class="v4-home-section v4-search-cta"><div><span class="v4-kicker">Find an answer</span><h2>Search the guide</h2><p>Search questions, facts, steps, and FAQs across the full research set.</p></div><a class="v4-action" href={generated.navigation.utilities?.find((item) => item.id === 'search')?.href ?? '/v4-preview/search/'}>Search now</a></section>
  {surfaces.map((surface: any) => { const items = bySurface(surface); return items.length > 0 && <section class:list={['v4-home-section', surface.id === 'hot-now' && 'v4-hot-now', surface.id === 'popular-questions' && 'v4-question-surface']}><div class="v4-section-heading"><div><span class="v4-kicker">Research surface</span><h2>{surface.label}</h2></div><span>{items.length} answers</span></div><div class:list={['v4-discovery-list', surface.id === 'featured-tasks' && 'is-task-grid']}>{items.map((item: any) => <a class="v4-discovery-item" href={item.href}>{item.pageData.media?.[0]?.localRef && <img src={item.pageData.media[0].localRef} alt="" loading="lazy" />}<span><strong>{item.title}</strong><small>{taskLabel(item)} · {item.pageData.intent.playerProblem}</small></span><b>{surface.id === 'popular-questions' ? '?' : 'Open'}</b></a>)}</div></section>})}
</main></body></html>
