---
import Shell from '../presentation/Shell.astro';
import generated from '../v4/generated/example-site.json';
---
<Shell title="Search Happy Wheels Steam Guides" description="Find answers about Happy Wheels on Steam." path="/search/"><main id="main" class="container utility-page"><p class="eyebrow">Find an answer</p><h1>Search Steam guides.</h1><label class="search-label">What do you want to know?<input type="search" id="guide-search" placeholder="Try Workshop, favorites or Steam Deck" /></label><p id="search-count" role="status">5 guides</p><div class="search-results">{generated.pages.map(page => <a href={page.href} data-search-text={JSON.stringify([page.title,page.pageData.body,page.pageData.facts]).toLowerCase()}><h2>{page.title}</h2><p>{page.pageData.body.intro}</p><span aria-hidden="true">↗</span></a>)}</div><p id="no-results" hidden>No matching guide yet. <a href="/category/">Browse all Steam guides.</a></p></main></Shell>
<script>
const input = document.querySelector<HTMLInputElement>('#guide-search')!;
const cards = [...document.querySelectorAll<HTMLAnchorElement>('[data-search-text]')];
const filter = () => { const query = input.value.trim().toLowerCase(); let count = 0; for (const card of cards) { card.hidden = !card.dataset.searchText?.includes(query); if (!card.hidden) count++; } document.querySelector('#search-count')!.textContent = `${count} guide${count === 1 ? '' : 's'}`; document.querySelector<HTMLElement>('#no-results')!.hidden = count > 0; };
input.value = new URLSearchParams(location.search).get('q') ?? ''; input.addEventListener('input',filter); filter();
</script>
