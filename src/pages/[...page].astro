---
import generated from '../v4/generated/example-site.json';
import presentation from '../../site-input/presentation.json';
import Shell from '../presentation/Shell.astro';
import GuideCard from '../presentation/GuideCard.astro';
import SemanticPrimitive from '../components/v4/SemanticPrimitive.astro';
import PageBody from '../components/v4/PageBody.astro';
export function getStaticPaths() { return generated.pages.map(page => ({params:{page:page.id},props:{page}})); }
const page = Astro.props.page as typeof generated.pages[number];
const ui = presentation[page.id as keyof typeof presentation];
const answer = page.composition.primitives.find(primitive => primitive.id === 'A02');
const facts = page.composition.primitives.find(primitive => primitive.id === 'E01');
const relatedIds = Object.keys(presentation).filter(id => id !== page.id).slice(0,3) as (keyof typeof presentation)[];
---
<Shell title={page.title} description={ui.description} path={page.href} image={ui.image ? `/assets/happy-wheels/${ui.image}.webp` : undefined}>
<main id="main" class:list={['guide-page',`page-${page.id}`,`tone-${ui.tone}`]} data-v4-page={page.id}>
<div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/#guides">Steam guides</a><span aria-hidden="true">/</span><span aria-current="page">{ui.label}</span></nav>
<header class:list={['guide-hero', !ui.image && 'guide-hero-status']}><div><p class="eyebrow">HAPPY WHEELS / {ui.label}</p><h1>{page.title}</h1><div class="metadata"><span class="pill">{ui.status}</span><time datetime="2026-09-13">Updated Sep 13, 2026</time><span>Pre-launch</span></div></div>{ui.image && <figure><img src={`/assets/happy-wheels/${ui.image}.webp`} alt={ui.alt} width="854" height="480" fetchpriority="high" /><figcaption>Official trailer imagery</figcaption></figure>}</header>
<div class="article-layout"><article>
<div id="quick-answer">{answer && <SemanticPrimitive primitive={answer} page={page} gameName="Happy Wheels" />}</div>
<section class:list={['intent-panel',`panel-${ui.panel.kind}`]} id="current-status"><p class="eyebrow">Current status</p><h2>{ui.panel.title}</h2><div class="panel-rows">{ui.panel.rows.map(([label,status,detail],i) => <div class="panel-row"><span class="panel-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><h3>{label}</h3><p>{detail}</p></div><span class:list={['row-status',/not |open|partial|pre-launch|checkpoint|Sep 21/i.test(status) && 'pending']}>{status}</span></div>)}</div></section>
{facts && <SemanticPrimitive primitive={facts} page={page} gameName="Happy Wheels" />}
{page.pageData.body.sections.map(section => <section class="body-section" id={section.id}><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}{section.bullets.length > 0 && <ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>}</section>)}
<section id="faq"><PageBody body={page.pageData.body} onlyFaq={true} /></section>
<p class="source-note">Based on the {page.id === 'steam-deck' ? 'Steam-derived compatibility metadata' : 'official Steam listing'} available September 13, 2026. {page.id === 'steam-deck' ? 'This page does not report a hands-on test.' : 'Details may change before release.'}</p>
</article><aside class="article-sidebar"><nav aria-label="On this page"><span class="eyebrow">On this page</span><a href="#quick-answer">Quick answer</a><a href="#current-status">Current status</a>{page.pageData.body.sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}<a href="#faq">Common questions</a></nav><div class="rail-note"><p class="eyebrow">Scheduled release</p><strong>21<span>SEP 2026</span></strong><a class="text-link" href="/steam-release/">Release guide ↗</a></div><a class="sidebar-back" href="/#guides">← Browse Steam guides</a></aside></div>
<section class="section related-section"><div class="section-heading"><div><p class="eyebrow">Keep going</p><h2>Related Steam guides.</h2></div></div><div class="guide-grid">{relatedIds.map(id => <GuideCard id={id} compact />)}</div></section>
</div></main></Shell>
