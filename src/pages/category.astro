---
import Shell from '../presentation/Shell.astro';
import GuideCard from '../presentation/GuideCard.astro';
import presentation from '../../site-input/presentation.json';
const ids = Object.keys(presentation) as (keyof typeof presentation)[];
---
<Shell title="Happy Wheels Steam Guides" description="Browse Happy Wheels Steam release, Workshop, old accounts, controller support and Steam Deck guides." path="/category/"><main id="main" class="container utility-page"><p class="eyebrow">All five guides</p><h1>Happy Wheels on Steam.</h1><div class="guide-grid">{ids.map(id => <GuideCard id={id} />)}</div></main></Shell>
